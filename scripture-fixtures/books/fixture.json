          "t": "ሁለተኛው ምዕራፍ ይህ ነው።"
        },
        {
          "n": 2,
          "t": "ሙከራው ቀጥሏል፥ ገና አላለቀም።"
        },
        {
          "n": 3,
          "t": "መጨረሻ"
        }
      ]
    }
